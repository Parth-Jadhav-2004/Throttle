{
  "name": "throttle",
  "version": "0.1.1",
  "description": "An always-on-top Windows widget for live Codex subscription usage limits.",
  "main": "src/main.js",
  "author": "Parth Jadhav",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "npm run dist:portable && npm run dist:installer",
    "dist:portable": "electron-builder --win portable --config.directories.output=dist/portable",
    "dist:installer": "electron-builder --win nsis --config.directories.output=dist/installer"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.parthjadhav.throttle",
    "productName": "Throttle",
    "files": ["src/**/*", "assets/throttle.png", "package.json"],
    "win": {"icon": "assets/throttle.ico", "target": ["portable", "nsis"]},
    "portable": {"artifactName": "Throttle-${version}-${arch}-Portable.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Throttle-${version}-${arch}-Setup.${ext}"}
  }
}
